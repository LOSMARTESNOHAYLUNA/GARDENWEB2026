# ==========================================================
# Garden Solution Mallorca - configuracion Apache (Hostinger)
# Generado a partir de vercel.json
# ==========================================================

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# --- HTTPS ---
# dinahosting ya fuerza HTTPS a nivel de servidor ("Forzar HTTPS" activado),
# por eso NO se añade aquí, para evitar bucles de redireccion detras de Varnish.

# --- Forzar dominio sin www ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ==========================================================
# Redirecciones 301 (migradas de vercel.json)
# Se omiten las que solo anaden barra final: Apache ya lo hace.
# ==========================================================

RedirectMatch 301 ^/es/mantenimiento\-de\-jardines/?$ /es/mantenimiento-jardines-particulares/
RedirectMatch 301 ^/es/mantenimiento\-de\-jardines\-particulares/?$ /es/mantenimiento-jardines-particulares/
