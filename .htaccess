# ==========================================================
# Content-Type para sitemaps / XSL
# ==========================================================
<FilesMatch "sitemap.*\.xml$">
  Header set Content-Type "application/xml; charset=utf-8"
</FilesMatch>
<FilesMatch "sitemap\.xsl$">
  Header set Content-Type "text/xsl; charset=utf-8"
</FilesMatch>

# ==========================================================
# Cache de assets estaticos (1 ano, immutable)
# ==========================================================
<FilesMatch "\.(webp|jpg|jpeg|png|svg|gif|ico|woff2|woff|ttf|css|js)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ==========================================================
# Compresion GZIP (mejora velocidad)
# ==========================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

